{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P5Reader",
  "version": "0.1.0",
  "identifier": "com.p5reader.reader",
  "build": {
    "beforeDevCommand": "npm.cmd run serve",
    "beforeBuildCommand": "npm.cmd run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P5Reader",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
